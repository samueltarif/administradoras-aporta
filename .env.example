# Copie para .env e preencha LOCALMENTE. Nunca versionar o .env.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
# Chave pública (publishable/anon). Pode ir ao navegador; a proteção real é a RLS.
SUPABASE_KEY=
# Chave secreta (service_role/secret). SOMENTE servidor/scripts. Nunca expor no cliente.
SUPABASE_SECRET_KEY=
# Seed de contas fictícias: só em projeto de desenvolvimento.
DEMO_SEED_ENABLED=false
