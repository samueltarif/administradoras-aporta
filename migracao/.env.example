# Preencha LOCALMENTE. Nao versionar seu arquivo .env com dados reais.
# Restaurar o .bak no SQL Server antes de executar a exportacao.
SQLSERVER_CONN_STR="DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=Samuel;UID=sa;PWD=COLOQUE_SENHA_AQUI;Encrypt=yes;TrustServerCertificate=yes"
# Obtenha a URI PostgreSQL em Supabase > Project Settings > Database.
SUPABASE_DB_URL="postgresql://postgres...:SENHA@HOST:5432/postgres?sslmode=require"
# Necessario somente quando rodar import_supabase.py --apply
MIGRATION_CONFIRM="I_UNDERSTAND_THIS_UPLOADS_REAL_CUSTOMER_DATA"
